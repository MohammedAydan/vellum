# ─── Environment ──────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug

# ─── Control Plane Database ───────────────────────────────
# OWNER URL — migrations / DDL only. The API runtime must not use this in production.
# Local Docker: postgres://vellum:vellum_dev_password@localhost:5432/control_db
# Neon (production): postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/control_db?sslmode=require
CONTROL_DATABASE_URL=postgres://vellum:vellum_dev_password@localhost:5432/control_db
CONTROL_DATABASE_URL_DIRECT=postgres://vellum:vellum_dev_password@localhost:5432/control_db
CONTROL_DATABASE_DRIVER=pg
# OPTIONAL least-privilege runtime role (vellum_app, non-superuser).
# When set, request-time connections use this URL; migrations/DDL ALWAYS use
# CONTROL_DATABASE_URL above. Leave unset only for local development.
# CONTROL_DATABASE_APP_URL=postgres://vellum_app:vellum_app_dev_password@localhost:5432/control_db

# ─── Data Plane Database ──────────────────────────────────
# OWNER URL — migrations / DDL only. RLS is enforced for all request-time work.
# Local Docker: postgres://vellum:vellum_dev_password@localhost:5433/data_db
# Neon (production): postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/data_db?sslmode=require
DATA_DATABASE_URL=postgres://vellum:vellum_dev_password@localhost:5433/data_db
DATA_DATABASE_URL_DIRECT=postgres://vellum:vellum_dev_password@localhost:5433/data_db
DATA_DATABASE_DRIVER=pg
# OPTIONAL least-privilege runtime role (vellum_app, non-superuser).
# When set, request-time connections use this URL; migrations/DDL ALWAYS use
# DATA_DATABASE_URL above. Leave unset only for local development.
# DATA_DATABASE_APP_URL=postgres://vellum_app:vellum_app_dev_password@localhost:5433/data_db
# SESSION-MODE endpoint used ONLY by the PostgreSQL LISTEN client for realtime.
# Neon `-pooler` hosts drop LISTEN; use the non-pooler endpoint here. If unset,
# the engine derives it from DATA_DATABASE_URL and falls back to outbox polling.
# DATA_DATABASE_URL_LISTEN=postgres://user:pass@ep-xxx.region.aws.neon.tech/data_db?sslmode=require

# ─── Authentication & Security ────────────────────────────
# All secrets must be >= 16 characters. In NODE_ENV=production the hardcoded
# development defaults below are REJECTED at startup — replace every one.
BETTER_AUTH_SECRET=dev_secret_change_me_to_32_char_random_string_abc123
BETTER_AUTH_URL=http://localhost:8080
API_KEY_PEPPER=dev_pepper_change_me_to_32_char_random_string_xyz789
CURSOR_HMAC_SECRET=dev_hmac_secret_change_me_to_32_char_random_string_def456
JWT_SECRET=dev_jwt_secret_change_me_to_32_char_random_string_jkl345
SESSION_COOKIE_SECRET=dev_session_secret_change_me_to_32_char_random_string_ghi012
# Realm-bound session secrets. Optional in development (fall back to JWT_SECRET);
# REQUIRED and must be DISTINCT in NODE_ENV=production. Never commit real values.
# CONSOLE_JWT_SECRET=
# SUPER_ADMIN_JWT_SECRET=

# ─── End-User JWT Verification (JWKS) ─────────────────────
# Distinct from JWT_SECRET above: JWT_SECRET signs Console session tokens.
# Leave blank to disable end-user JWT verification (server keys only).
JWT_JWKS_URL=
JWT_ISSUER=
JWT_AUDIENCE=
JWKS_FETCH_TIMEOUT_MS=5000
JWKS_CACHE_TTL_SECONDS=300

# ─── API Server ───────────────────────────────────────────
API_PORT=8080
API_HOST=0.0.0.0
API_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
RATE_LIMIT_RPS_DEFAULT=100

# ─── Dashboards ───────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080
VITE_ENVIRONMENT=development

# ─── Observability ────────────────────────────────────────
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ─── End-User Auth (AES-256-GCM encryption of secrets at rest) ───────────
MASTER_ENCRYPTION_KEY=dev_master_key_change_me_to_64_hex_chars_0123456789abcdef0123456789abcdef

# ─── Production Hosting (Vercel / Cloudflare / Docker / Railway / Render) ─────
# Copy these names into each host's environment settings; never commit real
# values. Secret and database URL names below are documented as commented
# placeholders so the local development defaults above stay usable.

# Frontend build / runtime (unified dist-frontend + gateway):
# Leave VITE_API_BASE_URL empty for same-origin /v1 through the gateway (Docker,
# Caddy) or a host-level /v1 rewrite (Vercel). For split Vercel + Railway/Render
# deployments set it to https://api.<domain> at BUILD time.
VITE_API_BASE_URL=

# Backend API (listens on 8080; the API runtime reads API_PORT):
PORT=8080
API_PORT=8080
# CONTROL_DATABASE_URL=
# DATA_DATABASE_URL=
DATABASE_MODE=postgres
# MASTER_ENCRYPTION_KEY=
# SUPER_ADMIN_JWT_SECRET=
# CONSOLE_JWT_SECRET=
# One-time bootstrap secret for /v1/admin/setup-owner (required in production;
# generate 32+ random chars, set it in Vercel, then remove it after setup).
# ADMIN_SETUP_TOKEN=
CORS_ORIGINS=https://<domain>
# The API runtime reads CORS_ALLOWED_ORIGINS — keep it in sync with the above.
CORS_ALLOWED_ORIGINS=https://<domain>

