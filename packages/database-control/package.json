{
  "name": "@vellum/database-control",
  "version": "0.0.9",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./adapters": {
      "types": "./dist/adapters.d.ts",
      "import": "./dist/adapters.js"
    },
    "./contracts": {
      "types": "./dist/contracts/control-port.d.ts",
      "import": "./dist/contracts/control-port.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run",
    "migrate": "tsx ../../scripts/migrate.ts --only=control",
    "migrate:status": "tsx ../../scripts/migrate.ts --only=control --status"
  },
  "dependencies": {
    "@vellum/core": "workspace:*",
    "@neondatabase/serverless": "^0.10.4",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.30.4"
  }
}
