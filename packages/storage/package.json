{
  "name": "@vellum/storage",
  "version": "0.0.9",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters.d.ts",
      "import": "./dist/adapters.js"
    },
    "./contracts": {
      "types": "./dist/contracts/storage-port.d.ts",
      "import": "./dist/contracts/storage-port.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run",
    "test:security": "vitest run"
  },
  "dependencies": {
    "@vellum/core": "workspace:*",
    "@vellum/database-data": "workspace:*",
    "@vellum/query-engine": "workspace:*",
    "@neondatabase/serverless": "^0.10.4",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/pg": "^8.11.11"
  }
}
