{
  "name": "@vellum/realtime",
  "version": "0.0.10",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pubsub": {
      "types": "./dist/pg-notify-pubsub.d.ts",
      "import": "./dist/pg-notify-pubsub.js"
    }
