{
  "name": "vellum-monorepo",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "description": "Production-ready multi-tenant Document Database SaaS monorepo",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "corepack pnpm -r build",
    "typecheck": "corepack pnpm build && corepack pnpm -r typecheck",
    "lint": "corepack pnpm -r lint",
    "test": "corepack pnpm -r test",
    "test:unit": "corepack pnpm -r test:unit",
    "test:integration": "corepack pnpm -r test:integration",
    "test:security": "corepack pnpm -r test:security",
    "test:load": "k6 run tests/load/crud-throughput.js",
    "verify:dart": "dart run tests/dart-verify",
    "test:e2e": "playwright test",
    "qa:docs": "node scripts/qa/qa-docs-react.mjs",
    "test:e2e-real": "vitest run tests/e2e-real",
    "test:coverage": "vitest run --coverage --coverage.include='packages/*/src/**/*.{ts,tsx}' --coverage.include='apps/*/src/**/*.{ts,tsx}' --exclude 'tests/e2e-real/**' --exclude 'tests/e2e/**' --exclude 'tests/integration/**' --exclude 'tests/load/**' --exclude 'tests/sdk-js-harsh/**' --exclude 'tests/flutter-stress/**'",
    "dev:api": "corepack pnpm --filter @vellum/api dev",
    "dev:frontend": "node scripts/dev/frontend-gateway.mjs --mode=dev",
    "dev:stack": "node scripts/dev/dev-stack.mjs",
    "build:frontend": "node scripts/build-unified-frontend.mjs",
    "build:api": "node scripts/build-backend.mjs",
    "build:console": "node scripts/build-frontend.mjs",
    "dev:backend": "node scripts/dev/dev-backend.mjs",
    "dev:console": "node scripts/dev/dev-frontend.mjs",
    "verify:split": "node scripts/verify-split.mjs",
    "deploy:plan": "node scripts/deploy-vercel.mjs",
    "deploy:check": "node scripts/deploy-vercel.mjs --check",
    "start:frontend": "node scripts/dev/frontend-gateway.mjs --mode=prod",
    "start:api": "corepack pnpm --filter @vellum/api start",
    "dev:env-check": "node scripts/dev/env-check.js",
    "serve:all": "node scripts/dev/serve-all.js",
    "dev": "corepack pnpm -r --parallel dev",
    "check:node": "node -e \"const v=process.versions.node.split('.').map(Number); if(v[0]<22){console.error('Node >=22 required (found '+process.versions.node+')'); process.exit(1)}; console.log('Node '+process.versions.node+' OK')\"",
    "verify": "corepack pnpm typecheck && corepack pnpm lint && corepack pnpm test",
    "bench": "tsx scripts/bench.ts",
    "bench:k6": "corepack pnpm test:load",
    "bench:explain": "tsx tests/load/explain-regression.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx tests/load/seed.ts",
    "smoke": "tsx scripts/smoke-http-pg.ts",
    "docs:examples": "node scripts/run-examples.mjs",
    "docs:build": "corepack pnpm --filter @vellum/docs build",
    "docs:verify": "corepack pnpm docs:examples && corepack pnpm docs:build",
    "codegen:openapi": "tsx scripts/generate-openapi.ts",
    "codegen:dart-errors": "tsx scripts/generate-dart-errors.ts",
    "codegen:check": "tsx scripts/generate-openapi.ts --check && tsx scripts/generate-dart-errors.ts --check",
    "version:check": "node scripts/check-version-sync.mjs",
    "docs:typecheck-examples": "node scripts/qa/check-sdk-doc-snippets.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.48.0",
    "@storybook/addon-a11y": "^9.1.21",
    "@storybook/addon-docs": "^9.1.21",
    "@storybook/react": "^9.1.21",
    "@storybook/react-vite": "^9.1.21",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^6.4.24",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^2.1.8",
    "drizzle-orm": "^0.38.3",
    "eslint": "^9.18.0",
    "fast-check": "^4.10.2",
    "mitata": "^1.0.34",
    "playwright": "^1.65.1",
    "storybook": "^9.1.21",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.8",
    "ws": "^8.23.0"
  },
  "dependencies": {
    "nodemailer": "^6.10.1"
  },
  "packageManager": "pnpm@10.15.0+sha512.486ebc259d3e999a4e8691ce03b5cac4a71cbeca39372a9b762cb500cfdf0873e2cb16abe3d951b1ee2cf012503f027b98b6584e4df22524e0c7450d9ec7aa7b"
}
