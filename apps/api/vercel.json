{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node ../../scripts/build-backend.mjs && cd ../.. && corepack pnpm db:migrate",
  "installCommand": "cd ../.. && corepack pnpm install --frozen-lockfile",
  "outputDirectory": "public",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "/api/server?path=/v1/:path*"
    },
    {
      "source": "/health",
      "destination": "/api/server?path=/v1/health"
    },
    {
      "source": "/ready",
      "destination": "/api/server?path=/v1/health/ready"
    }
  ],
  "crons": [
    { "path": "/v1/internal/maintenance", "schedule": "17 3 * * *" }
  ],
  "functions": {
    "api/server/index.js": {
      "maxDuration": 300
    }
  }
}
