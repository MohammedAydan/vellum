{
  "name": "@vellum/docs",
  "version": "0.0.10",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5175 --host 0.0.0.0",
    "build": "tsc --noEmit && vite build --outDir dist --emptyOutDir && node scripts/build-ai-docs.mjs",
    "preview": "vite preview --outDir dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@vellum/ui": "workspace:*",
    "lucide-react": "^0.460.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.4.6",
    "vitest": "^2.1.8"
  }
}
